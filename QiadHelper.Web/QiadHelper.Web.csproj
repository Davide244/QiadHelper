<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>QiadHelper.Web</AssemblyName>
    <RootNamespace>QiadHelper.Web</RootNamespace>
    <Description>QIAD Helper host: admin UI + public case database + minimal API, running the Discord bot in-process</Description>
    <UserSecretsId>a0308a67-faea-4d38-a7d8-98b39702d15d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- TypeScript settings - use tsconfig.json from project directory, not output -->
    <TypeScriptCompileOnSaveEnabled>True</TypeScriptCompileOnSaveEnabled>
    <TypeScriptBuildMode>true</TypeScriptBuildMode>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <TypeScriptConfigFile>$(MSBuildProjectDirectory)\tsconfig.json</TypeScriptConfigFile>
  </PropertyGroup>

  <!-- Prevent tsconfig.json from being copied to output directory -->
  <ItemGroup>
    <Content Update="tsconfig.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Authentication & Security -->
  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Discord" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Sentry.AspNetCore" />
  </ItemGroup>

  <!-- Entity Framework Core -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Development Tools -->
  <ItemGroup>
    <PackageReference Include="Microsoft.TypeScript.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\QiadHelper.Core\QiadHelper.Core.csproj" />
    <ProjectReference Include="..\QiadHelper.Bot\QiadHelper.Bot.csproj" />
  </ItemGroup>

</Project>
