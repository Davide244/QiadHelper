# QIAD Helper — compose environment (design §13.5).
# Copy to `.env` (gitignored) and fill in. Config flows to the app as
# `Section__Key` environment variables; there are no user-secrets in containers.

# ---- Database (internal network only; never published) ----
POSTGRES_DB=qiad
POSTGRES_USER=qiad
POSTGRES_PASSWORD=change-me

# ---- Discord application ----
# Bot token (leave empty together with BOT_ENABLED=false for a web-only deploy)
DISCORD_BOT_TOKEN=
# OAuth2 credentials for the staff web login (redirect URL: https://<host>/signin-discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Bot behaviour ----
BOT_ENABLED=true
# The QIAD guild (can also be set later in the admin panel; DB config wins)
MAIN_GUILD_ID=0
# Commands register only here when ASPNETCORE_ENVIRONMENT=Development
DEV_GUILD_ID=0
# Bootstrap admin: this Discord user acts as Director before rank roles are mapped
DEVELOPER_USER_ID=0
# How staff drive the case workflow: Buttons | Commands | Both. Buttons = action buttons on
# the queue/thread/forum posts; Commands = slash commands (/add-decision, /issue-verdict, …);
# Both = both at once. Changing this needs a restart (commands re-register at gateway-ready).
STAFF_WORKFLOW_MODE=Buttons

# ---- Hosting ----
# Published app port (behind your reverse proxy)
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# ---- Guardsman verification API (optional) ----
# Enables automatic Discord to Roblox identity resolution on appeal intake and /restrict.
GUARDSMAN_API_KEY=
GUARDSMAN_USER_ID=

# ---- Monitoring (optional) ----
SENTRY_DSN=
